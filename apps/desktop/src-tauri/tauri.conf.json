{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contraseñas",
  "version": "0.1.0",
  "identifier": "app.contrasenas.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Contraseñas",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Contraseñas",
    "shortDescription": "Caja fuerte de contraseñas solo en tu PC",
    "longDescription": "Contraseñas guarda tus accesos cifrados en tu ordenador. No envía contraseñas a Internet.",
    "category": "Utility",
    "copyright": "Copyright © Proyecto Contraseñas",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      },
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
